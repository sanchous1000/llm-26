# Copy to .env (git-ignored) and adjust. Used by docker compose and by the Python code.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag

QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# MCP retrieval service (docker compose --profile app); bound to 127.0.0.1 of the host
MCP_PORT=8765

# Public host name of the MCP endpoint (nginx + Let's Encrypt)
DOMAIN=thesis.rag.mooo.com

# Grafana (https://$DOMAIN/grafana/): password of the admin user
GRAFANA_ADMIN_PASSWORD=change-me

# Host ports (127.0.0.1) the host-network nginx proxies to
GRAFANA_PORT=3000

# --- lab 3 agents ---
# opencode API key (OpenAI-compatible endpoint https://opencode.ai/inference/go/openai/v1)
OPENCODE_API_KEY=change-me
# papers-rag MCP tokens (issued on the server: ./tokens.sh create <name>)
PAPERS_RAG_TOKEN_AGENT=change-me
PAPERS_RAG_TOKEN_OPENCODE=change-me
# local Langfuse (deploy/langfuse/init-env.sh writes these)
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
LANGFUSE_BASE_URL=http://localhost:3000
